<?xml version="1.0" encoding="utf-8"?>
<!--
  SOLO en compilación DEBUG (sustentación / pruebas): permite HTTP hacia cualquier IP
  para poder usar un celular físico apuntando a la IP del PC (ej. http://192.168.1.10:5080/).
  La versión RELEASE usa src/main/res/xml/network_security_config.xml, que solo permite
  HTTP hacia el emulador (10.0.2.2) y localhost.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
