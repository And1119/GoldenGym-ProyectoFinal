<?xml version="1.0" encoding="utf-8"?>
<!--
  Entorno académico: la API corre por HTTP en el PC (localhost:5080).
  - 10.0.2.2 es la IP con la que el emulador ve el PC.
  - Para celular físico se usa la IP del PC en la red Wi-Fi (192.168.x.x).
  En producción se debe publicar la API con HTTPS y quitar el tráfico en texto plano.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
