    CTRL["Controllers<br/>(DTOs + DataAnnotations)"]
    SVC["Servicios de aplicación<br/>(reglas de negocio)"]
    INF["Infrastructure<br/>Repositorios EF Core · BCrypt · JwtTokenService"]
